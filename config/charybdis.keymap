#include <behaviors/num_word.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    combos {
        compatible = "zmk,combos";

        hanyoung {
            bindings = <&kp RIGHT_ALT>;
            key-positions = <20 19>;
        };

        esc {
            bindings = <&kp ESC>;
            key-positions = <15 16>;
        };

        capslock {
            bindings = <&kp CAPSLOCK>;
            key-positions = <1 2>;
        };

        printscreen {
            bindings = <&kp LG(LS(S))>;
            key-positions = <9 10>;
        };

        goback {
            bindings = <&kp LA(LEFT_ARROW)>;
            key-positions = <3 4>;
        };

        goforward {
            bindings = <&kp LA(RIGHT_ARROW)>;
            key-positions = <7 8>;
        };

        rctrl {
            bindings = <&kp RCTRL>;
            key-positions = <33 34>;
        };
    };

    behaviors {
        ht_mouse: ht_mouse {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_MOUSE";
            bindings = <&mkp>, <&mkp>;

            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
        };

        ht_delete: ht_delete {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_DELETE";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <130>;
        };

        td_mouse: td_mouse {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_MOUSE";
            #binding-cells = <0>;
            bindings = <&mkp LCLK>, <&ht_mouse RCLK LCLK>;

            tapping-term-ms = <300>;
        };

        ht_layer: ht_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_LAYER";
            bindings = <&tog>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <130>;
        };

        mod_F5: mod_F5 {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_F5";
            bindings = <&kp NUMBER_5>, <&kp F5>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&ht_delete LGUI TAB  &kp Q  &kp W  &kp E      &kp R      &kp T          &kp Y            &kp U        &kp I      &kp O       &kp P          &ht_delete BACKSPACE DELETE
&kp LEFT_ALT         &kp A  &kp S  &kp D      &kp F      &kp G          &kp H            &kp J        &kp K      &kp L       &kp SEMICOLON  &ht_layer 4 SQT
&kp LEFT_SHIFT       &kp Z  &kp X  &kp C      &kp V      &kp B          &kp N            &kp M        &kp COMMA  &kp PERIOD  &kp SLASH      &kp RIGHT_SHIFT
                                   &kp LCTRL  &td_mouse  &lt 1 SPACE    &lt 2 BACKSPACE  &lt 3 ENTER
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_1 {
            bindings = <
&trans  &kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp LS(N5)          &kp LS(NUMBER_6)   &kp LS(N7)     &kp LS(N8)     &kp LS(N9)     &kp LS(N0)     &trans
&trans  &kp NUMBER_1      &kp NUMBER_2      &kp NUMBER_3      &kp NUMBER_4      &kp N5              &kp NUMBER_6       &kp N7         &kp N8         &kp N9         &kp N0         &trans
&trans  &none             &kp GRAVE         &kp EQUAL         &kp MINUS         &kp LEFT_BRACKET    &kp RIGHT_BRACKET  &kp LS(MINUS)  &kp LS(EQUAL)  &kp LS(GRAVE)  &kp BACKSLASH  &trans
                                            &trans            &trans            &trans              &trans             &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &kp F1      &kp F2   &kp F3  &kp F4  &kp F5    &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &trans
&trans  &kp F11     &kp F12  &none   &none   &none     &none   &none   &none   &none   &none    &trans
&trans  &kp INSERT  &none    &none   &none   &none     &none   &none   &none   &none   &none    &trans
                             &trans  &trans  &trans    &trans  &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &kp HOME  &msc SCRL_UP    &kp UP_ARROW    &msc SCRL_DOWN   &kp PAGE_UP      &none   &kp C_VOLUME_DOWN  &kp C_MUTE        &kp C_VOLUME_UP  &bt BT_CLR  &trans
&trans  &kp END   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp PAGE_DOWN    &none   &kp C_PREVIOUS     &kp C_PLAY_PAUSE  &kp C_NEXT       &none       &trans
&trans  &none     &none           &none           &none            &none            &none   &none              &none             &none            &none       &trans
                                  &trans          &trans           &trans           &trans  &trans
            >;
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &kp F5              &kp HOME   &trans  &kp END    &trans               &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp LA(LEFT_ARROW)  &mkp LCLK  &mo 5   &mkp RCLK  &kp LA(RIGHT_ARROW)  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans              &trans     &trans  &trans     &trans               &trans
                        &trans  &trans  &trans    &trans              &trans
            >;
        };

        scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
            >;
        };
    };
};
